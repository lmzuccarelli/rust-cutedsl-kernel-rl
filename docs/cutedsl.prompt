# OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

"""
SM80 (Ampere) SIMT GEMM using tensor core MMA.

This kernel uses a single warp (32 threads) with a 16x8x8 MMA atom.
"""

def main():
    # 1. Define dimensions (Must align with your block/tiler sizes)
    M, N, K = 16, 8, 8
    device = torch.device("cuda:0")
    
    # 2. Initialize inputs on CUDA device as float16
    torch.manual_seed(42)
    
    # Using Row-Major layouts for A and D, Column-Major for B
    # cutedsl will automatically infer layouts/strides from these PyTorch tensors
    A_torch = torch.randn((M, K), dtype=torch.float16, device=device)
    B_torch = torch.randn((K, N), dtype=torch.float16, device=device).t().contiguous().t() 
    D_torch = torch.zeros((M, N), dtype=torch.float16, device=device)

    # 3. Define Grid and Block configuration 
    block_cfg = (32, 1, 1) 
    grid_cfg = (M // 16, N // 8, 1)

    print(f"Launching kernel with Grid: {grid_cfg}, Block: {block_cfg}...")
    
    # 4. Launch the cutedsl kernel by passing the PyTorch tensors directly
    # The DSL wrapper handles Context management and type casting internally.
    sgemm_kernel[grid_cfg, block_cfg](A_torch, B_torch, D_torch)
    torch.cuda.synchronize()

    # 5. Compute Reference baseline using PyTorch
    D_ref = torch.matmul(A_torch, B_torch)

    # 6. Verify absolute and relative tolerances
    print("\n--- Verification Results ---")
    is_close = torch.allclose(D_torch, D_ref, rtol=1e-2, atol=1e-2)
    print(f"Arrays are close: {is_close}")
    
    if not is_close:
        max_diff = torch.max(torch.abs(D_torch - D_ref))
        print(f"Max absolute difference: {max_diff.item()}")
    else:
        print("Success! The kernel output matches the PyTorch reference.")```

## Your task

Write the complete `xxx.py` script. It must:

1. Use **only** the API patterns shown above. If a pattern isn't shown,
   derive it from the example file. Do NOT use: TMA, WGMMA, tcgen05,
   `cute.arch.shared_memory()`, `nvgpu.mma`, `from_dlpack`, multi-stage
   pipelines, or cluster launches.

2. Keep it to a **single warp, 16×8×8 MMA atom, one CTA per tile**.
   This is a correctness demo, not a performance kernel.

3. Include the verification harness at the bottom (`main()`).

4. Add a comment at the top noting: "Tested on sm_XX, CUTLASS DSL 4.8.0+".

5. Do NOT add any features not in the example. No autotuning, no multi-stage pipeline, no TMA, no 2-CTA clusters.

Output the complete file in a single code block. 
No explanation needed unless you deviate from the example's patterns — if you do, explain why.
